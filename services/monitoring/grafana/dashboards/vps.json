{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": false,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "CPU used",
      "description": "100 - idle, averaged over 5m.",
      "datasource": { "type": "prometheus", "uid": "eeo3k7o8vx0jkc" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 80 },
              { "color": "red", "value": 90 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{host_name=\"vps\",mode=\"idle\"}[5m])))",
          "instant": true
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Memory used",
      "description": "100 * (1 - MemAvailable / MemTotal).",
      "datasource": { "type": "prometheus", "uid": "eeo3k7o8vx0jkc" },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 85 },
              { "color": "red", "value": 95 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - node_memory_MemAvailable_bytes{host_name=\"vps\"} / node_memory_MemTotal_bytes{host_name=\"vps\"})",
          "instant": true
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Root filesystem used",
      "description": "mountpoint /, excluding tmpfs and overlay.",
      "datasource": { "type": "prometheus", "uid": "eeo3k7o8vx0jkc" },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 80 },
              { "color": "red", "value": 90 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - node_filesystem_avail_bytes{host_name=\"vps\",mountpoint=\"/\",fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{host_name=\"vps\",mountpoint=\"/\",fstype!~\"tmpfs|overlay\"})",
          "instant": true
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Load (1m)",
      "description": "The VPS has 2 vCPUs, so a sustained load above 2 is saturation.",
      "datasource": { "type": "prometheus", "uid": "eeo3k7o8vx0jkc" },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 2 },
              { "color": "red", "value": 4 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_load1{host_name=\"vps\"}",
          "instant": true
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "CPU time by mode",
      "description": "Per-mode share of one core, averaged over the vCPUs. Steal and iowait are the ones a provider causes.",
      "datasource": { "type": "prometheus", "uid": "eeo3k7o8vx0jkc" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 5 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "custom": { "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * avg by (mode) (rate(node_cpu_seconds_total{host_name=\"vps\",mode!=\"idle\"}[5m]))",
          "legendFormat": "{{mode}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Network throughput",
      "description": "All interfaces except loopback, bytes per second.",
      "datasource": { "type": "prometheus", "uid": "eeo3k7o8vx0jkc" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 5 },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": { "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(node_network_receive_bytes_total{host_name=\"vps\",device!=\"lo\"}[5m]))",
          "legendFormat": "received"
        },
        {
          "refId": "B",
          "expr": "sum(rate(node_network_transmit_bytes_total{host_name=\"vps\",device!=\"lo\"}[5m]))",
          "legendFormat": "sent"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Disk throughput",
      "description": "Read and written bytes per second.",
      "datasource": { "type": "prometheus", "uid": "eeo3k7o8vx0jkc" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 5 },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": { "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(node_disk_read_bytes_total{host_name=\"vps\"}[5m]))",
          "legendFormat": "read"
        },
        {
          "refId": "B",
          "expr": "sum(rate(node_disk_written_bytes_total{host_name=\"vps\"}[5m]))",
          "legendFormat": "written"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Edge responses by status",
      "description": "Requests per second per HTTP status.",
      "datasource": { "type": "prometheus", "uid": "eeo3k7o8vx0jkc" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(caddy_access_requests_total{environment=\"edge\"}[5m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Requests in flight",
      "description": "Caddy handlers currently serving a request.",
      "datasource": { "type": "prometheus", "uid": "eeo3k7o8vx0jkc" },
      "gridPos": { "h": 8, "w": 4, "x": 12, "y": 13 },
      "fieldConfig": {
        "defaults": { "unit": "short", "decimals": 0 },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "none",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(caddy_http_requests_in_flight{host_name=\"vps\"})",
          "instant": true
        }
      ]
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Caddy config reload",
      "description": "0 means the last config load failed and Caddy is on the old config.",
      "datasource": { "type": "prometheus", "uid": "eeo3k7o8vx0jkc" },
      "gridPos": { "h": 8, "w": 4, "x": 16, "y": 13 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "failed", "color": "red" },
                "1": { "text": "ok", "color": "green" }
              }
            }
          ],
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(caddy_config_last_reload_successful{host_name=\"vps\"})",
          "instant": true
        }
      ]
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Unhealthy upstreams",
      "description": "Reverse-proxy backends Caddy reports as down.",
      "datasource": { "type": "prometheus", "uid": "eeo3k7o8vx0jkc" },
      "gridPos": { "h": 8, "w": 4, "x": 20, "y": 13 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(caddy_reverse_proxy_upstreams_healthy{host_name=\"vps\"} == 0) or vector(0)",
          "instant": true
        }
      ]
    },
    {
      "id": 12,
      "type": "table",
      "title": "Upstream health",
      "description": "One row per reverse-proxy backend. healthy 1 = answering.",
      "datasource": { "type": "prometheus", "uid": "eeo3k7o8vx0jkc" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 21 },
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "cellOptions": { "type": "auto" } }
        },
        "overrides": []
      },
      "options": { "showHeader": true, "cellHeight": "sm" },
      "targets": [
        {
          "refId": "A",
          "expr": "caddy_reverse_proxy_upstreams_healthy{host_name=\"vps\"}",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "environment": true,
              "exported_instance": true,
              "exported_job": true,
              "host_name": true,
              "instance": true,
              "job": true,
              "otel_scope_name": true,
              "otel_scope_version": true,
              "service_namespace": true
            },
            "renameByName": { "Value": "healthy" }
          }
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Agent export queue",
      "description": "How full the VPS agent's OTLP queue is. At 100% it drops points and every panel on this page shows replayed data.",
      "datasource": { "type": "prometheus", "uid": "eeo3k7o8vx0jkc" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 29 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "thresholdsStyle": { "mode": "dashed" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 90 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": false, "calcs": [] },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(otelcol_exporter_queue_size{host_name=\"vps\"}) / sum(otelcol_exporter_queue_capacity{host_name=\"vps\"})",
          "legendFormat": "queue"
        }
      ]
    },
    {
      "id": 14,
      "type": "stat",
      "title": "Telemetry dropped (10m)",
      "description": "Points the agent could not enqueue because the queue was full.",
      "datasource": { "type": "prometheus", "uid": "eeo3k7o8vx0jkc" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 29 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(otelcol_exporter_enqueue_failed_metric_points_total{host_name=\"vps\"}[10m])) or vector(0)",
          "instant": true
        }
      ]
    }
  ],
  "refresh": "1m",
  "schemaVersion": 39,
  "tags": ["vps", "edge", "caddy"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "browser",
  "title": "VPS / Edge Host",
  "uid": "homelab-vps",
  "version": 1
}
