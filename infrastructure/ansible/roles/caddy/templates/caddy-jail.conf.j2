# Fail2ban jails for Caddy. Managed by Ansible (roles/caddy).
#
# One filter (caddy.conf) matches 400/403/404/429 and nothing else, so extra
# jails over that same filter cannot detect anything the jails below do not:
# they only differ in threshold. caddy-scan, caddy-attack, caddy-invalid and
# caddy-aggressive were removed for that reason. They also multiplied every ban
# by four, and would have sent four notifications for one address. Escalation
# now comes from `bantime.increment` in 00-ansible-defaults.conf instead.
#
# The nftables action that used to be hardcoded on caddy-envscan is gone: it
# replaced the distro ban action rather than adding to it, so that one jail
# banned differently from every other jail on the host.

[caddy]
enabled = true
filter = caddy
port = http,https
logpath = /var/log/caddy/*.access.log
backend = auto
maxretry = 5
findtime = 60
bantime = 600
{% if ntfy_security_token is defined and ntfy_security_token | length > 0 %}
# Default firewall ban, plus a notification. `action_` is the distro default
# (banaction with port and chain), so the firewall rule is not replaced.
action = %(action_)s
         ntfy
{% endif %}

[caddy-envscan]
# Anyone asking for a .env file is not a visitor. Ban on the first attempt.
enabled = true
filter = caddy-envscan
port = http,https
logpath = /var/log/caddy/*.access.log
backend = auto
maxretry = 1
findtime = 60
bantime = 3600
{% if ntfy_security_token is defined and ntfy_security_token | length > 0 %}
action = %(action_)s
         ntfy
{% endif %}
