# Internal services (Tailscale only)
# These bind to localhost only, accessible via Tailscale
127.0.0.1:22067 {
	reverse_proxy {{ server3 }}.{{ caddy_domain }}:22067
}

127.0.0.1:22026 {
	reverse_proxy {{ server3 }}.{{ caddy_domain }}:22026 {
		transport http {
			tls
			tls_insecure_skip_verify
		}	
	}
}

127.0.0.1:22070 {
	reverse_proxy {{ server3 }}.{{ caddy_domain }}:22070
}


*.{{ caddy_domain }} {
	import security_headers
	import request_limits
	import bot_protection
	
	# Enhanced logging
	log {
		output file /var/log/caddy/{{ caddy_domain }}.access.log {
			roll_size 100MB
			roll_keep 10
			roll_keep_for 720h
		}
		format json {
			time_format rfc3339
		}
	}
	
	# Error logging
	handle_errors {
		respond "{http.error.status_code} {http.error.status_text}" {http.error.status_code}
	}

	tls { 
		dns cloudflare {{ cloudflare_api_token }}
		resolvers 1.1.1.1 8.8.8.8
	}

	@proxy host proxy.{{ caddy_domain }}
	handle @proxy {
		reverse_proxy http://{{ server3 }}.{{ caddy_domain }}:22067 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Host {host}
		}
	}

	@joplin host joplin.{{ caddy_domain }}
	handle @joplin {
		# CSP for Joplin
		header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; media-src 'self'; frame-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self';"
		
		reverse_proxy http://{{ server2 }}.{{ caddy_domain }}:22300 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Host {host}
		}
	}

	@paste host paste.{{ caddy_domain }}
	handle @paste {
		# CSP for Paste service (allows uploads)
		header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; media-src 'self' blob:; frame-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self';"
		
		reverse_proxy http://{{ server3 }}.{{ caddy_domain }}:10500 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Host {host}
		}
	}

	@rss host rss.{{ caddy_domain }}
	handle @rss {
		# CSP for RSS reader
		header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self' https:; media-src 'self' https:; frame-src 'self'; frame-ancestors 'none';"
		
		reverse_proxy http://{{ server2 }}.{{ caddy_domain }}:9111 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Host {host}
		}
	}

	@audiobookshelf host audiobookshelf.{{ caddy_domain }}
	handle @audiobookshelf {
		# CSP for audiobook streaming
		header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self'; connect-src 'self' wss:; media-src 'self' blob:; frame-src 'self'; frame-ancestors 'none';"
		
		reverse_proxy /opds* http://{{ server4 }}:2007 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Host {host}
		}
		reverse_proxy /     http://{{ server4 }}:2008 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Host {host}
		}
	}

	@mempool host mempool.{{ caddy_domain }}
	handle @mempool {
		# CSP for mempool explorer
		header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self' wss: https:; media-src 'self'; frame-src 'none'; frame-ancestors 'none';"
		
		reverse_proxy http://{{ server1 }}.{{ caddy_domain }}:8050 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Host {host}
		}
	}

	@nc host nc.{{ caddy_domain }}
	handle @nc {
		# CSP for NextCloud
		header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline' 'unsafe-eval'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https: wss: blob:; media-src 'self' blob:; frame-src 'self' blob:; frame-ancestors 'self'; worker-src 'self' blob:;"
		
		reverse_proxy http://{{ server1 }}.{{ caddy_domain }}:18600 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Host {host}
		}
	}

	@music host music.{{ caddy_domain }}
	handle @music {
		# CSP for music streaming
		header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self'; media-src 'self' blob:; frame-src 'none'; frame-ancestors 'none';"
		
		reverse_proxy http://{{ server1 }}.{{ caddy_domain }}:4553 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Host {host}
		}
	}

	@n host n.{{ caddy_domain }}
	handle @n {
		# CSP for n service
		header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self'; frame-src 'none'; frame-ancestors 'none';"
		
		reverse_proxy http://localhost:2586 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Host {host}
		}

		# Redirect HTTP to HTTPS for GET requests
		@httpget {
			protocol http
			method GET
			path_regexp ^/([-_a-z0-9]{0,64}$|docs/|static/)
		}
		redir @httpget https://{host}{uri}
	}

	handle {
		abort
	}
}
