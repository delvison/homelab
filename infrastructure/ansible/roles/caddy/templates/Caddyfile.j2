# Production-hardened Caddyfile
# Security features enabled:
# - Admin API bound to localhost only
# - HSTS with preload
# - Security headers (X-Frame-Options, CSP, etc.)
# - Request body limit: 50MB
# - Bot and attack pattern blocking
# - Enhanced logging
#
# NOTE: Rate limiting available via fail2ban jails
# For application-level rate limiting, install caddy-rate-limit module

{
	# Bind admin API to localhost only for security
	admin 127.0.0.1:2019
	
	servers {
		metrics
	}
}

# Snippet: Common security headers
(security_headers) {
	header {
		# HSTS - preload ready
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		
		# Clickjacking protection
		X-Frame-Options "DENY"
		
		# MIME sniffing protection
		X-Content-Type-Options "nosniff"
		
		# XSS protection
		X-XSS-Protection "1; mode=block"
		
		# Referrer policy
		Referrer-Policy "strict-origin-when-cross-origin"
		
		# Remove server identification
		-Server
		
		# Permissions policy
		Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
	}
}

# Snippet: Request limits and timeouts
(request_limits) {
	request_body {
		max_size 50MB
	}
}

